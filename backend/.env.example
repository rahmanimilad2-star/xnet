# ---- Server ----
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
# آدرس عمومی (پشت nginx با HTTPS)
PUBLIC_URL=https://panel.example.com
# اگر پشت nginx هستید true بگذارید تا IP واقعی از X-Forwarded-For خوانده شود
TRUST_PROXY=true

# ---- Database ----
DB_PATH=/var/lib/vpn-panel/data.db

# ---- Secrets (حتماً عوض کنید: openssl rand -hex 32) ----
# کلید امضای توکن‌ها
JWT_SECRET=change_me_64_hex_chars
# کلید رمزنگاری AES-256-GCM برای رمز پنل‌های 3X-UI (دقیقاً 64 کاراکتر hex)
DATA_ENC_KEY=change_me_64_hex_chars

# ---- Tokens ----
USER_TOKEN_TTL_HOURS=720
ADMIN_TOKEN_TTL_HOURS=12

# ---- Login rate limit ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- 3X-UI stats collector ----
# هر چند ثانیه آمار مصرف از پنل‌های 3X-UI خوانده شود (0 = غیرفعال)
STATS_INTERVAL_SECONDS=30
# در صورت اتمام حجم/اعتبار، کلاینت در 3X-UI هم غیرفعال شود
ENFORCE_ON_XUI=true
# اگر پنل 3X-UI گواهی self-signed دارد true کنید (توصیه نمی‌شود)
XUI_ALLOW_INSECURE_TLS=false

# ---- Subscription URLs ----
# هر چند دقیقه لینک‌های Subscription دوباره خوانده شوند (0 = فقط دستی)
SUBSCRIPTION_REFRESH_MINUTES=60
